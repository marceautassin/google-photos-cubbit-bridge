{
  "name": "google-photos-cubbit-bridge",
  "version": "1.0.0",
  "description": "Bridge application to sync photos from Google Photos to Cubbit storage",
  "main": "dist/index.js",
  "bin": {
    "gpb": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "google-photos",
    "cubbit",
    "sync",
    "backup",
    "photos",
    "typescript"
  ],
  "author": "Marceau",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.462.0",
    "@aws-sdk/lib-storage": "^3.462.0",
    "@types/yauzl": "^2.10.3",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.1.1",
    "googleapis": "^129.0.0",
    "mime-types": "^2.1.35",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "progress": "^2.0.3",
    "winston": "^3.11.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.10.0",
    "@types/progress": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=8.0.0"
  }
}
