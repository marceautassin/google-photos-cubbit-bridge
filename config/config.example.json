{
  "cubbit": {
    "endpoint": "${CUBBIT_ENDPOINT}",
    "accessKeyId": "${CUBBIT_ACCESS_KEY_ID}",
    "secretAccessKey": "${CUBBIT_SECRET_ACCESS_KEY}",
    "bucket": "${CUBBIT_BUCKET}",
    "region": "${CUBBIT_REGION}",
    "forcePathStyle": true
  },
  "sync": {
    "maxConcurrentDownloads": 3,
    "supportedFormats": [
      "jpg",
      "jpeg",
      "png",
      "gif",
      "bmp",
      "webp",
      "heic",
      "heif",
      "dng",
      "mp4",
      "mov",
      "avi",
      "mkv",
      "m4v",
      "3gp",
      "webm",
      "mts"
    ],
    "preserveFolderStructure": true,
    "chunkSize": 1048576,
    "retryAttempts": 3,
    "retryDelay": 1000
  },
  "logging": {
    "level": "info",
    "file": "./logs/app.log",
    "console": true,
    "maxSize": "10m",
    "maxFiles": 5
  },
  "database": {
    "path": "./data/app.db",
    "backupPath": "./data/app.backup.db"
  },
  "repair": {
    "sourcePrefixes": [
      "backup_google_photos/photos/",
      "2_Personnel/Photos/google_photos/"
    ],
    "keptAlbums": [
      "mariage"
    ],
    "ignoredFileNames": [
      ".DS_Store",
      "Thumbs.db",
      "desktop.ini",
      ".picasa.ini",
      "Picasa.ini",
      "Icon\r"
    ],
    "ignoredExtensions": []
  }
}