{
  "googlePhotos": {
    "clientId": "${GOOGLE_CLIENT_ID}",
    "clientSecret": "${GOOGLE_CLIENT_SECRET}",
    "redirectUri": "http://localhost:3000/auth/callback",
    "scopes": [
      "https://www.googleapis.com/auth/photoslibrary.readonly"
    ]
  },
  "cubbit": {
    "endpoint": "${CUBBIT_ENDPOINT}",
    "accessKeyId": "${CUBBIT_ACCESS_KEY_ID}",
    "secretAccessKey": "${CUBBIT_SECRET_ACCESS_KEY}",
    "bucket": "${CUBBIT_BUCKET}",
    "region": "${CUBBIT_REGION}",
    "forcePathStyle": true
  },
  "sync": {
    "downloadPath": "./temp_downloads",
    "maxConcurrentDownloads": 3,
    "supportedFormats": [
      "jpg",
      "jpeg",
      "png",
      "gif",
      "bmp",
      "webp",
      "mp4",
      "mov",
      "avi",
      "mkv"
    ],
    "preserveFolderStructure": true,
    "chunkSize": 1048576,
    "retryAttempts": 3,
    "retryDelay": 1000
  },
  "logging": {
    "level": "info",
    "file": "./logs/app.log",
    "console": true,
    "maxSize": "10m",
    "maxFiles": 5
  },
  "database": {
    "path": "./data/app.db",
    "backupPath": "./data/app.backup.db"
  }
}