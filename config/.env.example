# Configuration Cubbit
# Vos identifiants Cubbit S3-compatibles
CUBBIT_ENDPOINT=https://your-cubbit-endpoint.com
CUBBIT_ACCESS_KEY_ID=your_cubbit_access_key
CUBBIT_SECRET_ACCESS_KEY=your_cubbit_secret_key
CUBBIT_BUCKET=photos-backup
CUBBIT_REGION=us-east-1
# Bucket dédié aux photos, destination du plan de réparation (gpb plan generer)
CUBBIT_DESTINATION_BUCKET=photos

# Configuration générale
NODE_ENV=development
LOG_LEVEL=info
MAX_CONCURRENT_DOWNLOADS=3
